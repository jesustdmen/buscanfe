# Normaliza finais de linha de forma consistente entre Windows e Linux (container).
* text=auto eol=lf

# Scripts que rodam no container Linux DEVEM ser LF (CRLF quebra o shebang).
bin/* text eol=lf
*.sh  text eol=lf
Dockerfile* text eol=lf

# Scripts do Windows devem ser CRLF (para o cmd.exe).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários (não normalizar).
*.crt binary
*.pfx binary
*.p12 binary
*.png binary
*.ico binary
