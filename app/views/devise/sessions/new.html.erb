<% content_for :title, "Acessar o console" %>
<div style="min-height:100vh; display:grid; grid-template-columns:1.05fr .95fr;">
  <div style="position:relative; padding:56px 64px; display:flex; flex-direction:column; justify-content:space-between; background:var(--graphite); color:var(--graphite-ink); overflow:hidden;">
    <div style="display:flex; align-items:center; gap:12px;">
      <div style="width:30px; height:30px; border:1.5px solid currentColor; display:flex; align-items:center; justify-content:center; transform:rotate(45deg);"><div style="width:9px;height:9px;background:currentColor;"></div></div>
      <div style="font-weight:600; letter-spacing:.14em; font-size:12px; text-transform:uppercase;">Registro NF-e</div>
    </div>
    <div style="max-width:420px;">
      <div style="font-size:13px; letter-spacing:.16em; text-transform:uppercase; opacity:.55; margin-bottom:20px;">Console Fiscal · Entrada</div>
      <div style="font-size:30px; font-weight:600; line-height:1.22;">Confirmação da operação e download de XML de NF-e.</div>
      <div style="margin-top:22px; font-size:14px; line-height:1.6; opacity:.62;">Manifestação assinada com certificado digital A1 e escrita fiscal auditável. Cada confirmação é registrada, imutável e irreversível.</div>
    </div>
    <div class="mono" style="display:flex; gap:26px; font-size:11px; letter-spacing:.04em; opacity:.5;">
      <span>ICP-BRASIL · A1</span><span>SEFAZ · DistDFe 1.03</span><span>PROD</span>
    </div>
  </div>

  <div style="display:flex; align-items:center; justify-content:center; padding:40px;">
    <div style="width:100%; max-width:352px;">
      <div style="font-size:19px; font-weight:600;">Acessar o console</div>
      <div style="color:var(--ink-2); margin-top:6px; margin-bottom:30px; font-size:13.5px;">Use suas credenciais corporativas.</div>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <% if notice %><div class="flash notice"><%= notice %></div><% end %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.label :email, "E-mail", class: "label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field", style: "margin-bottom:18px;" %>
        <%= f.label :password, "Senha", class: "label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "field", style: "margin-bottom:26px;" %>
        <%= f.submit "Entrar", class: "btn btn-primary", style: "width:100%; padding:13px;" %>
      <% end %>
      <div style="margin-top:22px; font-size:11.5px; color:var(--ink-3); line-height:1.55; border-top:1px solid var(--line); padding-top:16px;">Este ambiente não armazena nem processa segredos no navegador. Certificados e senhas ficam cifrados no servidor.</div>
    </div>
  </div>
</div>
