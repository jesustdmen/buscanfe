<% content_for :title, "Criar administrador" %>
<div style="min-height:100vh; display:grid; grid-template-columns:1.05fr .95fr;">
  <div style="padding:56px 64px; display:flex; flex-direction:column; justify-content:space-between; background:var(--graphite); color:var(--graphite-ink);">
    <div style="display:flex; align-items:center; gap:12px;">
      <div style="width:30px; height:30px; border:1.5px solid currentColor; display:flex; align-items:center; justify-content:center; transform:rotate(45deg);"><div style="width:9px;height:9px;background:currentColor;"></div></div>
      <div style="font-weight:600; letter-spacing:.14em; font-size:12px; text-transform:uppercase;">Registro NF-e</div>
    </div>
    <div style="max-width:420px;">
      <div style="font-size:13px; letter-spacing:.16em; text-transform:uppercase; opacity:.55; margin-bottom:20px;">Primeira execução</div>
      <div style="font-size:30px; font-weight:600; line-height:1.22;">Crie o administrador do console.</div>
      <div style="margin-top:22px; font-size:14px; line-height:1.6; opacity:.62;">Esta tela só aparece na primeira subida, enquanto não existe nenhum usuário. Depois de criado o admin, ela fecha e todo acesso passa pelo login.</div>
    </div>
    <div class="mono" style="font-size:11px; opacity:.5;">SETUP · FIRST-RUN</div>
  </div>

  <div style="display:flex; align-items:center; justify-content:center; padding:40px;">
    <div style="width:100%; max-width:352px;">
      <div style="font-size:19px; font-weight:600;">Criar administrador</div>
      <div style="color:var(--ink-2); margin-top:6px; margin-bottom:30px; font-size:13.5px;">Defina e-mail e senha (mínimo 12 caracteres).</div>
      <% if alert %><div class="flash alert"><%= alert %></div><% end %>
      <% if @user.errors.any? %><div class="flash alert"><%= @user.errors.full_messages.to_sentence %></div><% end %>
      <%= form_with model: @user, url: setup_path, method: :post do |f| %>
        <%= f.label :email, "E-mail", class: "label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field", style: "margin-bottom:18px;" %>
        <%= f.label :password, "Senha", class: "label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "field", style: "margin-bottom:18px;" %>
        <%= f.label :password_confirmation, "Confirmar senha", class: "label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field", style: "margin-bottom:26px;" %>
        <%= f.submit "Criar administrador e entrar", class: "btn btn-primary", style: "width:100%; padding:13px;" %>
      <% end %>
      <div style="margin-top:22px; font-size:11.5px; color:var(--ink-3); line-height:1.55; border-top:1px solid var(--line); padding-top:16px;">A senha é protegida com bcrypt no servidor. Nenhum segredo é guardado no navegador.</div>
    </div>
  </div>
</div>
