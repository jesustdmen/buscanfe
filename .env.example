# Copie para .env (gitignored) OU exporte no ambiente antes de subir. NUNCA comite.

# Passphrase-mestra: fornecida NA SUBIDA, fica só em memória (NÃO em arquivo em produção).
# Deriva as chaves do Active Record Encryption (PBKDF2). Sem ela, o app não decifra os certs.
MASTER_PASSPHRASE=troque-por-uma-passphrase-forte

# Salt NÃO-secreto (contexto/versão). O segredo é a passphrase.
MASTER_KEY_SALT=nfe-registro/v1

# O administrador é criado na tela de setup (first-run), não por variável.
